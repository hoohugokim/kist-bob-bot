<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.kist-bob-bot</string>
    <key>UserName</key>
    <string>kbb</string>
    <key>WorkingDirectory</key>
    <string>/Users/kbb/kist-bob-bot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kbb/kist-bob-bot/kbb_agent.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TZ</key>
        <string>Asia/Seoul</string>
        <key>KBB_LIFECYCLE_NOTICE</key>
        <string>0</string>
        <key>KBB_LOCAL_CONF</key>
        <string>/Users/kbb/kbb-ops/sandbox.conf</string>
        <key>KBB_STATE_DIR</key>
        <string>/Users/kbb/kbb-ops/rehearsal-state</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ExitTimeOut</key>
    <integer>60</integer>
    <key>StandardOutPath</key>
    <string>/Users/kbb/kbb-ops/agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kbb/kbb-ops/agent.err</string>
</dict>
</plist>
